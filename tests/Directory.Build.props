<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test names read as sentences; argument-validation and culture rules add noise in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA1062;CA1305;CA1861;CA2007;CA1812</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
